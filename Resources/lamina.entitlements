<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- lamina (Contents/Helpers/lamina) sends the app its commands as Apple Events, which the hardened runtime allows
         only with this entitlement. macOS still asks the person before the first event reaches the app (Automation). -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
